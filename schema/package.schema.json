{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/milind-soni/openmausbot-teams/main/schema/package.schema.json",
  "title": "OpenMausBot Package",
  "description": "A complete, portable OpenMausBot outcome package. Runtime identifiers, credentials, conversations, approvals, memory, and local paths are intentionally excluded.",
  "type": "object",
  "required": ["format", "version", "package"],
  "properties": {
    "format": { "const": "openmaus.package" },
    "version": { "const": 1 },
    "package": {
      "type": "object",
      "required": [
        "id",
        "release",
        "name",
        "tagline",
        "summary",
        "category",
        "author",
        "license",
        "outcomes",
        "setupMinutes",
        "requirements",
        "agents"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "maxLength": 80
        },
        "release": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "maxLength": 32
        },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "tagline": { "type": "string", "minLength": 1, "maxLength": 160 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "category": { "type": "string", "minLength": 1, "maxLength": 80 },
        "author": {
          "type": "object",
          "required": ["name"],
          "properties": {
            "name": { "type": "string", "minLength": 1, "maxLength": 100 },
            "url": { "type": "string", "format": "uri", "maxLength": 300 }
          },
          "additionalProperties": false
        },
        "license": { "type": "string", "minLength": 1, "maxLength": 80 },
        "featured": { "type": "boolean" },
        "tags": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 40 }
        },
        "outcomes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": { "type": "string", "minLength": 1, "maxLength": 240 }
        },
        "setupMinutes": { "type": "integer", "minimum": 1, "maximum": 240 },
        "requirements": {
          "type": "object",
          "required": ["apps", "capabilities"],
          "properties": {
            "apps": {
              "type": "array",
              "maxItems": 30,
              "items": {
                "type": "object",
                "required": ["slug", "label", "reason"],
                "properties": {
                  "slug": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9_-]*$",
                    "maxLength": 80
                  },
                  "label": { "type": "string", "minLength": 1, "maxLength": 100 },
                  "reason": { "type": "string", "minLength": 1, "maxLength": 240 },
                  "optional": { "type": "boolean" }
                },
                "additionalProperties": false
              }
            },
            "capabilities": {
              "type": "array",
              "maxItems": 20,
              "uniqueItems": true,
              "items": {
                "enum": ["agents", "connected-apps", "computer", "local-files", "schedules"]
              }
            },
            "platforms": {
              "type": "array",
              "maxItems": 4,
              "uniqueItems": true,
              "items": { "enum": ["macos", "windows", "linux", "any"] }
            }
          },
          "additionalProperties": false
        },
        "agents": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": { "$ref": "#/$defs/agent" }
        },
        "chiefOfStaff": { "$ref": "#/$defs/key" },
        "rooms": {
          "type": "array",
          "maxItems": 30,
          "items": { "$ref": "#/$defs/room" }
        },
        "routines": {
          "type": "array",
          "maxItems": 50,
          "items": { "$ref": "#/$defs/routine" }
        },
        "playbooks": {
          "type": "array",
          "maxItems": 80,
          "items": { "$ref": "#/$defs/playbook" }
        },
        "examples": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "required": ["title", "input", "output"],
            "properties": {
              "title": { "type": "string", "minLength": 1, "maxLength": 120 },
              "input": { "type": "string", "minLength": 1, "maxLength": 4000 },
              "output": { "type": "string", "minLength": 1, "maxLength": 12000 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "key": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "maxLength": 64
    },
    "appearance": {
      "type": "object",
      "required": ["color"],
      "properties": {
        "color": {
          "enum": ["green", "blue", "red", "orange", "purple", "cyan", "pink", "yellow", "teal", "coral"]
        },
        "mascotExpression": { "type": "string", "maxLength": 80 }
      },
      "additionalProperties": false
    },
    "agent": {
      "type": "object",
      "required": ["key", "name", "title", "description", "appearance"],
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "title": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 4000 },
        "appearance": { "$ref": "#/$defs/appearance" },
        "playbooks": {
          "type": "array",
          "maxItems": 30,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/key" }
        }
      },
      "additionalProperties": false
    },
    "responder": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "agent"],
          "properties": {
            "kind": { "const": "agent" },
            "agent": { "$ref": "#/$defs/key" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind"],
          "properties": { "kind": { "enum": ["everyone", "mentions"] } },
          "additionalProperties": false
        }
      ]
    },
    "room": {
      "type": "object",
      "required": ["key", "name", "members", "bulletin", "defaultResponder"],
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "members": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/key" }
        },
        "bulletin": { "type": "string", "maxLength": 12000 },
        "defaultResponder": { "$ref": "#/$defs/responder" }
      },
      "additionalProperties": false
    },
    "routine": {
      "type": "object",
      "required": ["key", "name", "agent", "prompt", "runOn", "schedule", "durationMinutes", "enabledAfterInstall"],
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "agent": { "$ref": "#/$defs/key" },
        "prompt": { "type": "string", "minLength": 1, "maxLength": 20000 },
        "runOn": { "enum": ["maus", "cloud"] },
        "schedule": {
          "oneOf": [
            {
              "type": "object",
              "required": ["type", "at"],
              "properties": {
                "type": { "const": "once" },
                "at": { "type": "integer" }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": ["type", "time", "weekdays"],
              "properties": {
                "type": { "const": "daily" },
                "time": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$" },
                "weekdays": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 7,
                  "uniqueItems": true,
                  "items": { "type": "integer", "minimum": 0, "maximum": 6 }
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "durationMinutes": { "type": "integer", "minimum": 15, "maximum": 240 },
        "enabledAfterInstall": { "const": false }
      },
      "additionalProperties": false
    },
    "playbook": {
      "type": "object",
      "required": ["key", "name", "summary", "triggers", "instructions"],
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 300 },
        "triggers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 100 }
        },
        "instructions": { "type": "string", "minLength": 1, "maxLength": 24000 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
